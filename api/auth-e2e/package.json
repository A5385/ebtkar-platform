{
  "name": "@org/api-auth-e2e",
  "version": "0.0.1",
  "private": true,
  "devDependencies": {
    "@types/jest": "catalog:",
    "jest": "catalog:",
    "jest-environment-node": "catalog:",
    "ts-jest": "catalog:"
  },
  "nx": {
    "name": "api-auth-e2e",
    "implicitDependencies": [
      "api-auth"
    ],
    "targets": {
      "e2e": {
        "executor": "@nx/jest:jest",
        "outputs": [
          "{projectRoot}/test-output/jest/coverage"
        ],
        "dependsOn": [
          "api-auth:build",
          "api-auth:serve"
        ],
        "options": {
          "jestConfig": "api/auth-e2e/jest.config.cts",
          "passWithNoTests": true
        }
      }
    }
  }
}