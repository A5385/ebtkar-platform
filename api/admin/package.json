{
    "name": "@org/api-admin",
    "version": "0.0.1",
    "private": true,
    "nx": {
        "name": "api-admin",
        "targets": {
            "build": {
                "executor": "nx:run-commands",
                "options": {
                    "command": "webpack-cli build",
                    "env": {
                        "NODE_ENV": "production"
                    },
                    "cwd": "api/admin"
                },
                "configurations": {
                    "development": {
                        "env": {
                            "NODE_ENV": "development"
                        }
                    }
                }
            },
            "prune-lockfile": {
                "dependsOn": [
                    "build"
                ],
                "cache": true,
                "executor": "@nx/js:prune-lockfile",
                "outputs": [
                    "{workspaceRoot}/api/admin/dist/package.json",
                    "{workspaceRoot}/api/admin/dist/pnpm-lock.yaml"
                ],
                "options": {
                    "buildTarget": "build"
                }
            },
            "copy-workspace-modules": {
                "dependsOn": [
                    "build"
                ],
                "cache": true,
                "outputs": [
                    "{workspaceRoot}/api/admin/dist/workspace_modules"
                ],
                "executor": "@nx/js:copy-workspace-modules",
                "options": {
                    "buildTarget": "build"
                }
            },
            "prune": {
                "dependsOn": [
                    "prune-lockfile",
                    "copy-workspace-modules"
                ],
                "executor": "nx:noop"
            },
            "serve": {
                "continuous": true,
                "executor": "@nx/js:node",
                "defaultConfiguration": "development",
                "dependsOn": [
                    "build"
                ],
                "options": {
                    "buildTarget": "api-admin:build",
                    "runBuildTargetDependencies": false
                },
                "configurations": {
                    "development": {
                        "buildTarget": "api-admin:build:development"
                    },
                    "production": {
                        "buildTarget": "api-admin:build:production"
                    }
                }
            },
            "test": {
                "options": {
                    "passWithNoTests": true
                }
            }
        }
    },
   "dependencies": {
  "@nestjs/common": "catalog:",
  "@nestjs/core": "catalog:",
  "@nestjs/platform-express": "catalog:",
  "reflect-metadata": "catalog:",
  "rxjs": "catalog:",
  "tslib": "catalog:"
},
"devDependencies": {
  "@nestjs/testing": "catalog:",
  "@types/jest": "catalog:",
  "jest": "catalog:",
  "jest-environment-node": "catalog:",
  "ts-jest": "catalog:",
  "webpack": "catalog:",
  "webpack-cli": "catalog:",
  "webpack-dev-server": "catalog:"
}
}
