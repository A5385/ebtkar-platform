        <!-- Notes -->

        <mxCell id="notes"
                value="Enterprise Design Principles&#xa;&#xa;• PostgreSQL = Notification Source of Truth&#xa;• Kafka = Event Backbone / Asynchronous Processing&#xa;• WebSocket = Real-time delivery only&#xa;• Redis = Cache + WebSocket Pub/Sub&#xa;• Every event has eventId for idempotency&#xa;• Retry + DLQ for failed delivery&#xa;• Preferences control enabled channels&#xa;• Templates are managed independently from business services&#xa;• Multi-tenant: tenantId on all notification data"
                style="shape=note;whiteSpace=wrap;html=1;backgroundOutline=1;fillColor=#fff2cc;strokeColor=#d6b656;"
                vertex="1"
                parent="1">
