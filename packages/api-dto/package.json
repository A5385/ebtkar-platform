{
  "name": "@repo/api-dto",
  "version": "1.0.0",
  "description": "Schemas package for the repo contain the common schema definitions",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js",
      "default": "./dist/index.js"
    },
    "./*": {
      "types": "./dist/*.d.ts",
      "import": "./dist/*.js",
      "default": "./dist/*.js"
    }
  },
  "scripts": {
    "build:pkg": "tsc -b -v",
    "dev:pkg": "tsc --watch",
    "format": "prettier --write \"**/*.{ts,tsx}\"",
    "lint": "eslint src/",
    "ts": "tsc --noEmit"
  },
  "keywords": [],
  "author": "",
  "license": "ISC",
  "packageManager": "pnpm@10.33.4",
  "dependencies": {
    "class-transformer": "catalog:",
    "class-validator": "catalog:",
    "zod": "catalog:"
  },
  "devDependencies": {
    "nestjs-zod": "catalog:",
    "@repo/eslint-config": "workspace:*",
    "@repo/schemas": "workspace:*",
    "@repo/prettier-config": "workspace:*",
    "@repo/typescript-config": "workspace:*",
    "typescript": "catalog:"
  }
}
