{
  "name": "@repo/helpers",
  "version": "1.0.0",
  "type": "module",
  "description": "Helpers package for the repo contain the common helper functions",
  "files": [
    "dist"
  ],
  "main": "./dist/index.js",
  "module": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "scripts": {
    "build:pkg": "bunchee",
    "dev:pkg": "bunchee --watch",
    "lint": "eslint src/",
    "ts": "tsc --noEmit",
    "test": "vitest run",
    "test:watch": "vitest"
  },
  "keywords": [],
  "author": "",
  "license": "ISC",
  "packageManager": "pnpm@10.33.4",
  "exports": {
    ".": {
      "import": {
        "types": "./dist/es/index.d.ts",
        "default": "./dist/es/index.js"
      },
      "require": {
        "types": "./dist/cjs/index.d.cts",
        "default": "./dist/cjs/index.cjs"
      }
    }
  },
  "devDependencies": {
    "@repo/eslint-config": "workspace:*",
    "@repo/prettier-config": "workspace:*",
    "@repo/typescript-config": "workspace:*",
    "bunchee": "catalog:",
    "libsodium-wrappers": "catalog:",
    "typescript": "catalog:",
    "vitest": "^4.1.10"
  }
}
