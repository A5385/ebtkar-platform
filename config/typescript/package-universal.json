{
  "$schema": "https://json.schemastore.org/tsconfig",
  "extends": "./base.json",
  "compilerOptions": {
    "target": "ES2022",
    "lib": ["ES2022"],

    "module": "ESNext",
    "moduleResolution": "Bundler",

    "noEmit": false,
    "noEmitOnError": true,

    "declaration": true,
    "declarationMap": true,
    "sourceMap": true,

    "composite": true,
    "incremental": true
  }
}
