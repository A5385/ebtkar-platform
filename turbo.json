{
  "$schema": "https://turbo.build/schema.json",
  "ui": "tui",
  "globalEnv": [
    "DATABASE_URL",
    "PORT",
    "SERVER_PREFIX",
    "AUTH_MICROSERVICE_HOST",
    "AUTH_MICROSERVICE_PORT",
    "ALLOWED_ORIGINS"
  ],

  "tasks": {
    "build": {
      "dependsOn": ["^build"],
      "inputs": ["$TURBO_DEFAULT$", ".env*"],
      "outputs": ["dist/**"],
      "env": [
        "DATABASE_URL",
        "PORT",
        "SERVER_PREFIX",
        "AUTH_MICROSERVICE_HOST",
        "AUTH_MICROSERVICE_PORT",
        "ALLOWED_ORIGINS"
      ]
    },
    "lint": {
      "dependsOn": ["^lint"]
    },
    "format": {
      "dependsOn": ["^format"]
    },
    "typecheck": {
      "dependsOn": ["^typecheck"]
    },
    "dev": {
      "cache": false,
      "persistent": true
    },
    "dev:pkg": {
      "cache": false,
      "persistent": true
    },
    "build:pkg": {
      "cache": true,
      "persistent": true
    }
  }
}
