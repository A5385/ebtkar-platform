{
    "name": "@org/database-warehouse",
    "version": "0.0.1",
    "private": true,
    "type": "module",
    "main": "./dist/index.js",
    "module": "./dist/index.js",
    "types": "./dist/index.d.ts",
    "exports": {
        "./package.json": "./package.json",
        ".": {
            "@org/source": "./src/index.ts",
            "types": "./dist/index.d.ts",
            "import": "./dist/index.js",
            "default": "./dist/index.js"
        },
        "./prisma": {
            "@org/source": "./src/generated/prisma/client.ts",
            "types": "./dist/generated/prisma/client.d.ts",
            "import": "./dist/generated/prisma/client.js",
            "default": "./dist/generated/prisma/client.js"
        },
        "./prisma-namespace": {
            "@org/source": "./src/generated/prisma/internal/prismaNamespace.ts",
            "types": "./dist/generated/prisma/internal/prismaNamespace.d.ts",
            "import": "./dist/generated/prisma/internal/prismaNamespace.js",
            "default": "./dist/generated/prisma/internal/prismaNamespace.js"
        }
    },
    "scripts": {
        "db:gen": "prisma generate && pnpm --dir ../.. schemas:post-generate",
        "db:mig": "prisma migrate dev",
        "db:dep": "prisma migrate deploy",
        "db:seed": "prisma db seed",
        "db:studio": "prisma studio",
        "db:validate": "prisma validate",
        "db:format": "prisma format",
        "db:migrate:reset": "prisma migrate reset"
    },
    "nx": {
        "name": "database-warehouse",
        "targets": {
            "prisma-deploy": {
                "executor": "@nx-tools/nx-prisma:deploy"
            },
            "prisma-format": {
                "executor": "@nx-tools/nx-prisma:format"
            },
            "prisma-generate": {
                "executor": "nx:run-commands",
                "options": {
                    "cwd": "src/database/warehouse",
                    "command": "pnpm db:gen"
                }
            },
            "prisma-migrate": {
                "executor": "nx:run-commands",
                "options": {
                    "cwd": "src/database/warehouse",
                    "command": "pnpm db:mig",
                    "forwardAllArgs": true
                }
            },
            "prisma-pull": {
                "executor": "@nx-tools/nx-prisma:pull"
            },
            "prisma-push": {
                "executor": "@nx-tools/nx-prisma:push"
            },
            "prisma-reset": {
                "executor": "@nx-tools/nx-prisma:reset"
            },
            "prisma-resolve": {
                "executor": "@nx-tools/nx-prisma:resolve"
            },
            "prisma-seed": {
                "executor": "@nx-tools/nx-prisma:seed"
            },
            "prisma-status": {
                "executor": "@nx-tools/nx-prisma:status"
            },
            "prisma-studio": {
                "executor": "@nx-tools/nx-prisma:studio"
            },
            "prisma-validate": {
                "executor": "@nx-tools/nx-prisma:validate"
            }
        }
    },
    "dependencies": {
        "@prisma/adapter-pg": "catalog:",
        "@prisma/client": "catalog:",
        "dotenv": "catalog:",
        "@nestjs/common": "catalog:",
        "tslib": "catalog:"
    },
    "devDependencies": {
        "@types/pg": "catalog:",
        "prisma": "catalog:",
        "vite": "catalog:",
        "vite-plugin-dts": "catalog:",
        "vitest": "catalog:",
        "zod-prisma-types": "catalog:"
    }
}
