generator client {
  provider = "prisma-client"
  output   = "../src/generated/prisma"
}

datasource db {
  provider = "postgresql"
}

generator zod {
  provider = "npx zod-prisma-types"
  output   = "../../../packages/schemas/src/admin/generated"

  useMultipleFiles         = true
  writeBarrelFiles         = false
  createInputTypes         = false
  addInputTypeValidation   = false
  addIncludeType           = false
  addSelectType            = false
  validateWhereUniqueInput = false
  useDefaultValidators     = false
}

model ConfigState {
  id      Boolean @id @default(true)
  version Int     @default(1)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@map("config_state")
}

// platform settings
model GlobalSettings {
  id Boolean @id @default(true)

  platformName String  @default("Ebtkar")
  logo         String?
  favicon      String?

  maintenanceMode     Boolean @default(false)
  registrationEnabled Boolean @default(true)

  defaultLocale   String @default("en")
  defaultTimezone String @default("UTC")

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@map("global_settings")
}

enum Roles {
  SUPER_ADMIN
  ADMIN
  TENANT
}

// Cors Settings
enum HttpMethod {
  GET
  POST
  PUT
  PATCH
  DELETE
  OPTIONS
  HEAD
}

model AccessSettings {
  id          Boolean  @id @default(true)
  corsEnabled Boolean  @default(true)
  origins     Origin[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@map("access_settings")
}

model Origin {
  originId       String       @id @default(cuid())
  origin         String       @unique
  credentials    Boolean      @default(true)
  methods        HttpMethod[]
  allowedHeaders String[]
  exposedHeaders String[]

  accessSettingsId Boolean?
  accessSettings   AccessSettings? @relation(fields: [accessSettingsId], references: [id], onDelete: Cascade)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@unique([accessSettingsId, origin])
  @@map("origins")
}

// network settings
model NetworkSettings {
  id                Boolean @id @default(true)
  httpClientRetries Int     @default(3)
  requestTimeoutMs  Int     @default(30000)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@map("network_settings")
}

// tokens settings
model TokensConfig {
  id              Boolean @id @default(true)
  accessTokenExp  Int     @default(900)
  refreshTokenExp Int     @default(2592000)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@map("tokens_config")
}

// warehouse settings & Role and permissions
model WarehouseSettings {
  warehouseSettingsId String @id @default(cuid())

  name String
  logo String?
  code String  @unique

  roles WarehouseRole[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@map("warehouse_settings")
}

model WarehouseRole {
  warehouseRoleId     String                 @id @default(cuid())
  name                String
  code                String
  description         String?
  isSuperAdmin        Boolean                @default(false)
  warehouseSettingsId String
  warehouseSettings   WarehouseSettings      @relation(fields: [warehouseSettingsId], references: [warehouseSettingsId], onDelete: Cascade)
  permissions         WarehousePermissions[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@unique([warehouseSettingsId, code])
  @@map("warehouse_roles")
}

enum WarehousePermissions {
  BRANCH_CREATE
  BRANCH_UPDATE
  BRANCH_DELETE
  BRANCH_ARCHIVE
  BRANCH_READ

  STORE_CREATE
  STORE_UPDATE
  STORE_DELETE
  STORE_ARCHIVE
  STORE_READ
}

// INVOICE settings & Role and permissions
model InvoiceSettings {
  invoiceSettingsId String        @id @default(cuid())
  name              String        @unique
  logo              String?
  code              String        @unique
  roles             InvoiceRole[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@map("invoice_settings")
}

model InvoiceRole {
  InvoiceRoleId     String               @id @default(cuid())
  name              String               @unique
  description       String?
  isSuperAdmin      Boolean              @default(false)
  invoiceSettingsId String?
  invoiceSettings   InvoiceSettings?     @relation(references: [invoiceSettingsId], fields: [invoiceSettingsId], onDelete: Cascade)
  permissions       InvoicePermissions[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@map("invoice_role")
}

enum InvoicePermissions {
  INVOICE_CREATE
  INVOICE_UPDATE
  INVOICE_DELETE
  INVOICE_ARCHIVE
  INVOICE_READ
}

//////////////////////////////////////////////////////
// AUDIT
//////////////////////////////////////////////////////

model AuditLog {
  auditId  String  @id @default(cuid())
  userId   String?
  action   String
  entity   String
  oldValue Json?
  newValue Json?

  createdAt DateTime @default(now())

  @@map("audit_logs")
}
