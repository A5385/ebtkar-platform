{
    "name": "@org/web-ui",
    "version": "0.0.1",
    "imports": {
        "#/components/*": "./src/components/*.tsx",
        "#/hooks/*": "./src/hooks/*.ts",
        "#/lib/*": "./src/lib/*.ts"
    },
    "exports": {
        "./components/*": {
            "types": "./src/components/*.tsx",
            "import": "./src/components/*.tsx",
            "default": "./src/components/*.tsx"
        },
        "./hooks/*": {
            "types": "./src/hooks/*.ts",
            "import": "./src/hooks/*.ts",
            "default": "./src/hooks/*.ts"
        },
        "./lib/*": {
            "types": "./src/lib/*.ts",
            "import": "./src/lib/*.ts",
            "default": "./src/lib/*.ts"
        },
        "./styles.css": "./src/styles.css",
        "./package.json": "./package.json"
    },
    "nx": {
        "name": "web-ui"
    },
    "dependencies": {
        "@org/env": "workspace:*",
        "@base-ui/react": "catalog:",
        "@fontsource-variable/geist": "catalog:",
        "@shadcn/react": "catalog:",
        "class-variance-authority": "catalog:",
        "clsx": "catalog:",
        "cmdk": "catalog:",
        "date-fns": "catalog:",
        "embla-carousel-react": "catalog:",
        "input-otp": "catalog:",
        "lucide-react": "catalog:",
        "react-day-picker": "catalog:",
        "react-resizable-panels": "catalog:",
        "recharts": "catalog:",
        "tailwind-merge": "catalog:",
        "tailwindcss": "catalog:",
        "tw-animate-css": "catalog:"
    },
    "peerDependencies": {
        "react": "catalog:",
        "react-dom": "catalog:"
    },
    "devDependencies": {
        "@org/types": "workspace:*",
        "@testing-library/dom": "catalog:",
        "@testing-library/react": "catalog:",
        "@types/react": "catalog:",
        "@types/react-dom": "catalog:",
        "@vitejs/plugin-react": "catalog:",
        "@vitest/coverage-v8": "catalog:",
        "jsdom": "catalog:",
        "react": "catalog:",
        "react-dom": "catalog:",
        "vite": "catalog:",
        "vitest": "catalog:"
    }
}
