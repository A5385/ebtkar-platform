{
    "name": "@org/api-shared",
    "version": "0.0.1",
    "private": true,
    "type": "module",
    "main": "./dist/index.js",
    "module": "./dist/index.js",
    "types": "./dist/index.d.ts",
    "exports": {
        ".": {
            "@org/source": "./src/index.ts",
            "types": "./dist/index.d.ts",
            "import": "./dist/index.js",
            "default": "./dist/index.js"
        },
        "./package.json": "./package.json"
    },
    "scripts": {
        "dev:pkg": "rimraf dist && tsc -b -v --watch"
    },
    "nx": {
        "name": "api-shared",
        "targets": {
            "dev:pkg": {
                "executor": "nx:run-script",
                "options": {
                    "script": "dev:pkg"
                }
            }
        }
    },
    "dependencies": {
        "@keyv/redis": "catalog:",
        "@nestjs/cache-manager": "catalog:",
        "@nestjs/common": "catalog:",
        "@nestjs/core": "catalog:",
        "@nestjs/microservices": "catalog:",
        "@nestjs/throttler": "catalog:",
        "@org/constants": "workspace:*",
        "@org/env": "workspace:*",
        "@org/infra": "workspace:*",
        "@org/types": "workspace:*",
        "cache-manager": "catalog:",
        "date-fns": "catalog:",
        "dotenv": "catalog:",
        "express": "catalog:",
        "ioredis": "catalog:",
        "nest-winston": "catalog:",
        "socket.io": "catalog:",
        "winston": "catalog:"
    },
    "devDependencies": {
        "@types/express": "catalog:"
    }
}
