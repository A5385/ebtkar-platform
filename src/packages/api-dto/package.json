{
    "name": "@org/api-dto",
    "version": "0.0.1",
    "private": true,
    "type": "module",
    "main": "./dist/index.js",
    "module": "./dist/index.js",
    "types": "./dist/index.d.ts",
    "exports": {
        ".": {
            "@org/source": "./src/index.ts",
            "types": "./dist/index.d.ts",
            "import": "./dist/index.js",
            "default": "./dist/index.js"
        },
        "./package.json": "./package.json"
    },
    "scripts": {
        "dev:pkg": "tsc -b -v --watch"
    },
    "nx": {
        "name": "api-dto",
        "targets": {
            "dev:pkg": {
                "executor": "nx:run-script",
                "options": {
                    "script": "dev:pkg"
                }
            }
        }
    },
    "dependencies": {
        "@org/types": "workspace:*",
        "@org/schemas": "workspace:*",
        "nestjs-zod": "catalog:",
        "zod": "catalog:"
    }
}
