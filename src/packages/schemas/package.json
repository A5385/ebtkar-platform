{
    "name": "@org/schemas",
    "version": "0.0.1",
    "private": true,
    "type": "module",
    "main": "./dist/index.js",
    "module": "./dist/index.js",
    "types": "./dist/index.d.ts",
    "exports": {
        "./package.json": "./package.json",
        ".": {
            "@org/source": "./src/index.ts",
            "types": "./dist/index.d.ts",
            "import": "./dist/index.js",
            "default": "./dist/index.js"
        },
        "./auth": {
            "@org/source": "./src/auth/index.ts",
            "types": "./dist/auth/index.d.ts",
            "import": "./dist/auth/index.js",
            "default": "./dist/auth/index.js"
        },
        "./warehouse": {
            "@org/source": "./src/warehouse/index.ts",
            "types": "./dist/warehouse/index.d.ts",
            "import": "./dist/warehouse/index.js",
            "default": "./dist/warehouse/index.js"
        }
    },
    "nx": {
        "name": "shared-schemas"
    },
    "dependencies": {
        "@org/database-auth": "workspace:*",
        "@org/database-notification": "workspace:*",
        "@org/constants": "workspace:*",
        "@org/database-warehouse": "workspace:*",
        "tslib": "catalog:",
        "zod": "catalog:"
    },
    "devDependencies": {
        "vite": "catalog:",
        "vite-plugin-dts": "catalog:",
        "vitest": "catalog:"
    }
}
