{
    "name": "@org/admin",
    "version": "0.0.1",
    "private": true,
    "dependencies": {
        "@hookform/resolvers": "catalog:",
        "@org/constants": "workspace:*",
        "@org/localization": "workspace:*",
        "@org/query-client": "workspace:*",
        "@org/schemas": "workspace:*",
        "@org/shared-web": "workspace:*",
        "@tanstack/react-query": "catalog:",
        "@tanstack/react-router": "catalog:",
        "react": "catalog:",
        "react-dom": "catalog:",
        "react-hook-form": "catalog:",
        "react-i18next": "catalog:",
        "lucide-react":"catalog:",
        "socket.io-client": "catalog:",
        "zod": "catalog:"
    },
    "devDependencies": {
        "@org/types": "workspace:*",
        "@tailwindcss/vite": "catalog:",
        "@tanstack/router-plugin": "catalog:",
        "@testing-library/dom": "catalog:",
        "@testing-library/react": "catalog:",
        "@types/react": "catalog:",
        "@types/react-dom": "catalog:",
        "@vitejs/plugin-react": "catalog:",
        "@vitest/coverage-v8": "catalog:",
        "jsdom": "catalog:",
        "vite": "catalog:",
        "vitest": "catalog:"
    },
    "scripts": {
        "dev": "vite",
        "dev:build": "vite build --watch",
        "build": "pnpm -w exec nx build @org/admin"
    },
    "nx": {
        "targets": {
            "build": {
                "executor": "nx:run-commands",
                "outputs": [
                    "{projectRoot}/dist"
                ],
                "options": {
                    "command": "vite build",
                    "cwd": "src/web/admin"
                }
            }
        }
    }
}
