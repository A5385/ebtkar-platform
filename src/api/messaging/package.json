{
    "name": "@org/api-messaging",
    "version": "0.0.1",
    "private": true,
    "nx": {
        "name": "api-messaging",
        "targets": {
            "build": {
                "executor": "nx:run-commands",
                "outputs": [
                    "{projectRoot}/dist"
                ],
                "options": {
                    "command": "tsc --build tsconfig.app.json",
                    "cwd": "src/api/messaging"
                }
            },
            "serve": {
                "continuous": true,
                "executor": "@nx/js:node",
                "dependsOn": [
                    "build",
                    "watch-deps"
                ],
                "options": {
                    "buildTarget": "api-messaging:build",
                    "runBuildTargetDependencies": false,
                    "inspect": false
                }
            }
        }
    },
    "dependencies": {
        "@nestjs/common": "catalog:",
        "@nestjs/core": "catalog:",
        "@nestjs/microservices": "catalog:",
        "@nestjs/platform-express": "catalog:",
        "@org/api-shared": "workspace:*",
        "@org/constants": "workspace:*",
        "@org/database-notification": "workspace:*",
        "@org/types": "workspace:*",
        "kafkajs": "catalog:",
        "nodemailer": "catalog:",
        "express": "catalog:",
        "reflect-metadata": "catalog:",
        "rxjs": "catalog:",
        "tslib": "catalog:"
    },
    "devDependencies": {
        "@types/express": "catalog:",
        "@types/nodemailer": "catalog:"
    }
}
