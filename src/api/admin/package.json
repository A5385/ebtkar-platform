{
    "name": "@org/api-admin",
    "version": "0.0.1",
    "private": true,
    "nx": {
        "name": "api-admin",
        "targets": {
            "build": {
                "executor": "nx:run-commands",
                "outputs": [
                    "{projectRoot}/dist"
                ],
                "options": {
                    "command": "tsc --build tsconfig.app.json",
                    "cwd": "src/api/admin"
                }
            },
            "prune-lockfile": {
                "dependsOn": [
                    "build"
                ],
                "cache": true,
                "executor": "@nx/js:prune-lockfile",
                "outputs": [
                    "{workspaceRoot}/src/api/admin/dist/package.json",
                    "{workspaceRoot}/src/api/admin/dist/pnpm-lock.yaml"
                ],
                "options": {
                    "buildTarget": "build"
                }
            },
            "copy-workspace-modules": {
                "dependsOn": [
                    "build"
                ],
                "cache": true,
                "outputs": [
                    "{workspaceRoot}/src/api/admin/dist/workspace_modules"
                ],
                "executor": "@nx/js:copy-workspace-modules",
                "options": {
                    "buildTarget": "build"
                }
            },
            "prune": {
                "dependsOn": [
                    "prune-lockfile",
                    "copy-workspace-modules"
                ],
                "executor": "nx:noop"
            },
            "serve": {
                "continuous": true,
                "executor": "@nx/js:node",
                "defaultConfiguration": "development",
                "dependsOn": [
                    "build"
                ],
                "options": {
                    "buildTarget": "api-admin:build",
                    "runBuildTargetDependencies": false
                },
                "configurations": {
                    "development": {
                        "buildTarget": "api-admin:build:development"
                    },
                    "production": {
                        "buildTarget": "api-admin:build:production"
                    }
                }
            },
            "test": {
                "options": {
                    "passWithNoTests": true
                }
            }
        }
    },
    "dependencies": {
        "@org/api-dto": "workspace:*",
        "@org/api-shared": "workspace:*",
        "@org/constants": "workspace:*",
        "@nestjs/common": "catalog:",
        "@nestjs/core": "catalog:",
        "@nestjs/platform-express": "catalog:",
        "reflect-metadata": "catalog:",
        "rxjs": "catalog:",
        "tslib": "catalog:"
    },
    "devDependencies": {
        "@org/types": "workspace:*",
        "@nestjs/testing": "catalog:",
        "@types/jest": "catalog:",
        "jest": "catalog:",
        "jest-environment-node": "catalog:",
        "ts-jest": "catalog:",
        "webpack": "catalog:",
        "webpack-cli": "catalog:",
        "webpack-dev-server": "catalog:"
    }
}
