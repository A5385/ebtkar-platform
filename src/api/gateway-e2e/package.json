{
    "name": "@org/api-gateway-e2e",
    "version": "0.0.1",
    "private": true,
    "devDependencies": {
        "@types/jest": "catalog:",
        "jest": "catalog:",
        "jest-environment-node": "catalog:",
        "ts-jest": "catalog:"
    },
    "nx": {
        "name": "api-gateway-e2e",
        "implicitDependencies": [
            "api-gateway"
        ],
        "targets": {
            "e2e": {
                "executor": "@nx/jest:jest",
                "outputs": [
                    "{projectRoot}/test-output/jest/coverage"
                ],
                "dependsOn": [
                    "api-gateway:build",
                    "api-gateway:serve"
                ],
                "options": {
                    "jestConfig": "api/gateway-e2e/jest.config.cts",
                    "passWithNoTests": true
                }
            }
        }
    }
}
