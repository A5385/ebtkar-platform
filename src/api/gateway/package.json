{
    "name": "@org/api-gateway",
    "version": "0.0.1",
    "private": true,
    "nx": {
        "name": "api-gateway",
        "targets": {
            "build": {
                "executor": "nx:run-commands",
                "outputs": [
                    "{projectRoot}/dist"
                ],
                "options": {
                    "command": "tsc --build tsconfig.app.json",
                    "cwd": "src/api/gateway"
                }
            },
            "prune-lockfile": {
                "dependsOn": [
                    "build"
                ],
                "cache": true,
                "executor": "@nx/js:prune-lockfile",
                "outputs": [
                    "{workspaceRoot}/api/gateway/dist/package.json",
                    "{workspaceRoot}/api/gateway/dist/pnpm-lock.yaml"
                ],
                "options": {
                    "buildTarget": "build"
                }
            },
            "copy-workspace-modules": {
                "dependsOn": [
                    "build"
                ],
                "cache": true,
                "outputs": [
                    "{workspaceRoot}/api/gateway/dist/workspace_modules"
                ],
                "executor": "@nx/js:copy-workspace-modules",
                "options": {
                    "buildTarget": "build"
                }
            },
            "prune": {
                "dependsOn": [
                    "prune-lockfile",
                    "copy-workspace-modules"
                ],
                "executor": "nx:noop"
            },
            "watch-endpoints": {
                "continuous": true,
                "cache": false,
                "executor": "nx:run-commands",
                "options": {
                    "command": "pnpm endpoints:watch",
                    "cwd": "{workspaceRoot}"
                }
            },
            "serve": {
                "continuous": true,
                "executor": "@nx/js:node",
                "defaultConfiguration": "development",
                "dependsOn": [
                    "build",
                    "watch-deps",
                    "watch-endpoints"
                ],
                "options": {
                    "buildTarget": "api-gateway:build",
                    "runBuildTargetDependencies": false,
                    "inspect": false
                },
                "configurations": {
                    "development": {
                        "buildTarget": "api-gateway:build:development"
                    },
                    "production": {
                        "buildTarget": "api-gateway:build:production"
                    }
                }
            },
            "test": {
                "options": {
                    "passWithNoTests": true
                }
            }
        }
    },
    "dependencies": {
        "@org/api-dto": "workspace:*",
        "@org/api-shared": "workspace:*",
        "@org/constants": "workspace:*",
        "@nestjs/common": "catalog:",
        "@nestjs/core": "catalog:",
        "@org/schemas": "workspace:*",
        "@nestjs/platform-express": "catalog:",
        "reflect-metadata": "catalog:",
        "rxjs": "catalog:",
        "tslib": "catalog:",
        "@nestjs/microservices": "catalog:",
        "@nestjs/platform-socket.io": "catalog:",
        "@nestjs/websockets": "catalog:",
        "jose": "catalog:",
        "kafkajs": "catalog:",
        "socket.io": "catalog:",
        "cookie-parser": "catalog:",
        "express": "catalog:",
        "nestjs-zod": "catalog:"
    },
    "devDependencies": {
        "@types/express": "catalog:",
        "@types/cookie-parser": "catalog:",
        "@org/types": "workspace:*",
        "@nestjs/testing": "catalog:",
        "@types/jest": "catalog:",
        "jest": "catalog:",
        "jest-environment-node": "catalog:",
        "ts-jest": "catalog:",
        "webpack": "catalog:",
        "webpack-cli": "catalog:",
        "webpack-dev-server": "catalog:"
    }
}
