{
    "name": "@org/api-combine",
    "version": "0.0.1",
    "private": true,
    "scripts": {
        "dev": "sh -c \"tsc --build tsconfig.app.json --watch & node --watch --enable-source-maps dist/main.js\"",
        "build": "rimraf dist && nest build",
        "start:dev": "nest start",
        "start:api": "node dist/main.js"
    },
    "nx": {
        "name": "api-combine",
        "targets": {
            "dev": {
                "executor": "nx:run-script",
                "options": {
                    "script": "dev"
                }
            },
            "build": {
                "executor": "nx:run-commands",
                "outputs": [
                    "{projectRoot}/dist"
                ],
                "options": {
                    "command": "tsc --build tsconfig.app.json",
                    "cwd": "src/api/combine"
                }
            },
            "prune-lockfile": {
                "dependsOn": [
                    "build"
                ],
                "cache": true,
                "executor": "@nx/js:prune-lockfile",
                "outputs": [
                    "{projectRoot}/dist/package.json",
                    "{projectRoot}/dist/pnpm-lock.yaml"
                ],
                "options": {
                    "buildTarget": "build"
                }
            },
            "copy-workspace-modules": {
                "dependsOn": [
                    "build"
                ],
                "cache": true,
                "outputs": [
                    "{projectRoot}/dist/workspace_modules"
                ],
                "options": {
                    "buildTarget": "build"
                },
                "executor": "@nx/js:copy-workspace-modules"
            },
            "prune": {
                "dependsOn": [
                    "prune-lockfile",
                    "copy-workspace-modules"
                ],
                "executor": "nx:noop"
            },
            "test": {
                "options": {
                    "passWithNoTests": true
                }
            }
        }
    },
    "dependencies": {
        "@org/api-dto": "workspace:*",
        "@org/api-shared": "workspace:*",
        "@nestjs/mapped-types": "*",
        "@org/constants": "workspace:*",
        "@org/database-auth": "workspace:*",
        "@org/database-admin": "workspace:*",
        "@org/database-notification": "workspace:*",
        "@org/schemas": "workspace:*",
        "@nestjs/common": "catalog:",
        "@nestjs/core": "catalog:",
        "@nestjs/platform-express": "catalog:",
        "reflect-metadata": "catalog:",
        "rxjs": "catalog:",
        "tslib": "catalog:",
        "express": "catalog:",
        "@nestjs/microservices": "catalog:",
        "nodemailer": "catalog:",
        "kafkajs": "catalog:",
        "bcryptjs": "catalog:",
        "nestjs-zod": "catalog:"
    },
    "devDependencies": {
        "@org/types": "workspace:*",
        "@nestjs/testing": "catalog:",
        "@types/jest": "catalog:",
        "@types/express": "catalog:",
        "jest": "catalog:",
        "@types/nodemailer": "catalog:",
        "jest-environment-node": "catalog:",
        "ts-jest": "catalog:",
        "webpack": "catalog:",
        "webpack-cli": "catalog:",
        "webpack-dev-server": "catalog:"
    }
}
