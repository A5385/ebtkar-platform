{
    "extends": "@repo/typescript-config/nest.json",
    "compilerOptions": {
        "outDir": "./dist",
        "incremental": true,
        "tsBuildInfoFile": "./node_modules/.cache/tsconfig.tsbuildinfo",
        "types": [
            "node",
            "jest"
        ]
    },
    "include": [
        "src/**/*.ts",
        "test/**/*.ts"
    ],
    "exclude": [
        "node_modules",
        "dist",
        "coverage"
    ]
}