{
    "name": "api-auth",
    "version": "0.0.1",
    "description": "Ebtkar identity and authentication API",
    "private": true,
    "license": "UNLICENSED",
    "type": "commonjs",
    "scripts": {
        "build": "nest build",
        "dev": "nest start --watch",
        "start": "nest start",
        "start:dev": "nest start --watch",
        "start:debug": "nest start --debug --watch",
        "start:prod": "node dist/main.js",
        "lint": "eslint \"src/**/*.ts\" \"test/**/*.ts\"",
        "lint:fix": "eslint \"src/**/*.ts\" \"test/**/*.ts\" --fix",
        "format": "prettier --write .",
        "format:check": "prettier --check .",
        "typecheck": "tsc --noEmit -p tsconfig.json",
        "test": "jest",
        "test:watch": "jest --watch",
        "test:cov": "jest --coverage",
        "test:ci": "jest --ci --runInBand --coverage",
        "test:debug": "node --inspect-brk ./node_modules/jest/bin/jest.js --runInBand",
        "test:e2e": "jest --config ./test/jest-e2e.json",
        "check": "pnpm lint && pnpm typecheck && pnpm test"
    },
    "dependencies": {
        "@repo/auth-database": "workspace:*",
        "@repo/schemas": "workspace:*",
        "@nestjs/common": "catalog:",
        "@nestjs/mapped-types": "*",
        "@nestjs/core": "catalog:",
        "@nestjs/platform-express": "catalog:",
        "@repo/helpers": "workspace:*",
        "reflect-metadata": "catalog:",
        "cookie-parser": "catalog:",
        "bcryptjs": "catalog:",
        "@prisma/adapter-pg": "catalog:",
        "dotenv": "catalog:",
        "nestjs-zod": "catalog:",
        "rxjs": "catalog:"
    },
    "devDependencies": {
        "@types/cookie-parser": "catalog:",
        "@nestjs/cli": "catalog:",
        "pg": "catalog:",
        "@types/pg": "catalog:",
        "@nestjs/schematics": "catalog:",
        "@nestjs/testing": "catalog:",
        "@repo/eslint-config": "workspace:*",
        "@repo/prettier-config": "workspace:*",
        "@repo/typescript-config": "workspace:*",
        "@types/express": "catalog:",
        "@types/jest": "catalog:",
        "@types/node": "catalog:",
        "@types/supertest": "catalog:",
        "eslint": "catalog:",
        "jest": "catalog:",
        "prettier": "catalog:",
        "source-map-support": "catalog:",
        "supertest": "catalog:",
        "ts-jest": "catalog:",
        "ts-loader": "catalog:",
        "ts-node": "catalog:",
        "tsconfig-paths": "catalog:",
        "typescript": "catalog:"
    }
}
